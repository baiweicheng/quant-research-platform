# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Local data (regenerable via the CLI)
*.db
*.sqlite
*.sqlite3
data/*.db
data/backups/  # timestamped database backups (P5) — local only, never commit
data/french_factors_daily.csv  # Ken French factor cache, downloaded from the Market data page
data/company_tickers.json  # SEC ticker map, downloaded fresh by the EDGAR ingest CLI
data/alpaca_paper_keys.json  # Alpaca PAPER API keys — never commit
data/alpaca_order_reasons.json  # plain-English notes for Alpaca orders — never commit
data/alpaca_staging_queue.json  # staged Alpaca orders awaiting acceptance — never commit
data/killswitch.json  # P6 kill-switch flag — local only, never commit
data/STOP  # P6 manual stop-file flag — local only, never commit
data/audit.log  # P6 append-only audit trail — local only, never commit
data/audit-export-*  # exported audit logs — local only, never commit

